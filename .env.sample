# ── BloumeChat Bot Configuration ────────────────────────────────────────────────
# Obtenez votre token sur https://bloumechat.com/developers
BOT_TOKEN=votre_token_ici

# Préfixe des commandes (défaut : !)
BOT_PREFIX=!

# Votre propre ID utilisateur (optionnel, pour les commandes owner-only)
OWNER_ID=
